# ===========================================
# SISDAT Forecast - Production Environment
# ===========================================
# IMPORTANT: Never commit this file with real values!
# Copy to .env.production and fill with real credentials

# ===========================================
# DATABASE
# ===========================================
# Production database (PostgreSQL recommended)
DATABASE_URL="postgresql://user:password@production-host:5432/sisdat_forecast?schema=public&connection_limit=10&pool_timeout=20"

# Optional: Non-pooling connection for migrations
DATABASE_URL_NON_POOLING="postgresql://user:password@production-host:5432/sisdat_forecast"

# ===========================================
# AUTHENTICATION
# ===========================================
# NextAuth configuration
NEXTAUTH_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS"
NEXTAUTH_URL="https://sisdat-forecast.yourdomain.com"

# Session & JWT secrets (generate with: openssl rand -base64 32)
SESSION_SECRET="CHANGE_THIS_SESSION_SECRET_32_CHARS_MINIMUM"
JWT_SECRET="CHANGE_THIS_JWT_SECRET_32_CHARS_MINIMUM"

# ===========================================
# SECURITY - reCAPTCHA
# ===========================================
# Get from: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6L..."
RECAPTCHA_SECRET_KEY="6L..."

# ===========================================
# ERROR MONITORING - SENTRY
# ===========================================
# Get from: https://sentry.io/settings/your-org/projects/your-project/keys/
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_ORG="your-organization"
SENTRY_PROJECT="sisdat-forecast"
SENTRY_AUTH_TOKEN="sntrys_..."

# Sentry environment
SENTRY_ENVIRONMENT="production"

# Error sampling rate (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"

# ===========================================
# APPLICATION CONFIG
# ===========================================
NEXT_PUBLIC_APP_NAME="SISDAT Forecast"
NEXT_PUBLIC_APP_VERSION="2.1.0"
NEXT_PUBLIC_COMPANY="ARCONEL - Agencia de Regulación y Control de Electricidad"
NEXT_PUBLIC_APP_ENV="production"

# ===========================================
# API URLS
# ===========================================
# External API base URLs
NEXT_PUBLIC_API_BASE_URL="https://api.arconel.gob.ec"
ARCONEL_API_KEY="your-arconel-api-key"

# Internal API URL
NEXT_PUBLIC_SITE_URL="https://sisdat-forecast.yourdomain.com"

# ===========================================
# MAP CONFIGURATION
# ===========================================
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT="-1.8312"
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG="-78.1834"
NEXT_PUBLIC_DEFAULT_MAP_ZOOM="6"

# Mapbox token (if using Mapbox instead of OSM)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ===========================================
# ANALYTICS & MONITORING
# ===========================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ===========================================
# CACHING & PERFORMANCE
# ===========================================
# Redis connection (optional, for distributed cache)
REDIS_URL="redis://default:password@production-redis:6379"
REDIS_CACHE_TTL="300"

# Cache control
CACHE_MAX_AGE="300"
STALE_WHILE_REVALIDATE="600"

# ===========================================
# EMAIL (for notifications)
# ===========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="noreply@yourdomain.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="SISDAT Forecast <noreply@yourdomain.com>"

# Admin email for alerts
ADMIN_EMAIL="admin@yourdomain.com"

# ===========================================
# RATE LIMITING
# ===========================================
# Requests per minute per IP
RATE_LIMIT_RPM="60"
RATE_LIMIT_WINDOW="60000"

# ===========================================
# BACKUP & MAINTENANCE
# ===========================================
# S3 or compatible storage for backups
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET="sisdat-backups"
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET_KEY=""

# Backup schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL="info"
LOG_FORMAT="json"

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_ANALYTICS="true"
ENABLE_ERROR_REPORTING="true"
ENABLE_PERFORMANCE_MONITORING="true"
ENABLE_CACHE="true"
ENABLE_RATE_LIMITING="true"

# ===========================================
# DEPLOYMENT INFO
# ===========================================
VERCEL_ENV="production"
VERCEL_URL=""
VERCEL_GIT_COMMIT_SHA=""
